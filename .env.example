# Test Mode — set to "true" to send live score summaries to the group
TEST_MODE=false

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Dedicated Telegram Chat/Channel ID for trick notifications
TELEGRAM_TRICK_CHAT_ID=your_telegram_trick_chat_id_here

# Cricket API
CRICKET_API_URL=https://api.goscorer.com/api/v3/getLiveMatches
CRICKET_API_JWT=your_jwt_token_here
CRICKET_COUNTRY_CODE=IN

# Polling interval in milliseconds (2000 = 2 seconds, minimum 1000)
POLL_INTERVAL_MS=2000

# Scorecard API (captain / wicketkeeper / per-batter figures).
# Needs no auth token. Only override these if the upstream endpoints move.
SCORECARD_API_URL=https://api.goscorer.com/api/v3/getSC4
PLAYER_MAP_API_URL=https://oc.crickapi.com/mapping/getHomeMapData

# MongoDB URI for persisting state (required for production)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cricket?retryWrites=true&w=majority

# Twilio Voice Call Alert Configuration (disabled by default)
ENABLE_TWILIO_CALLS=false
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBERS=+1234567890,+0987654321
TWILIO_CALL_DELAY_MS=5000

# Frontend API Configuration
# Comma-separated list of allowed origins for CORS (e.g. https://your-app.vercel.app)
# Set to * to allow all origins (not recommended for production)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3001
# API key for write operations (PATCH/POST/DELETE). Leave empty to disable auth.
API_KEY=your_secret_api_key_here
